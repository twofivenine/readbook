// 독서모임 앱 "책읽는 밤" — TRD v1.1 §4 (단일 테넌트, 멤버 없음, 브라우저 식별값 기반)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PollKind {
  book
  place
}

enum PollStatus {
  open
  closed
}

enum AttendanceStatus {
  yes
  no
  undecided
}

/// §4.1 회차 — 월(label, YYYY-MM)이 회차의 정체성. 접속한 달 기준으로 "이달의 책"이 정해진다
model Round {
  id        String    @id @default(uuid()) @db.Uuid
  seq       Int       @unique @default(autoincrement())
  label     String    @unique
  bookId    String?   @map("book_id") @db.Uuid
  meetingAt DateTime? @map("meeting_at")
  placeId   String?   @map("place_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  book        Book?        @relation(fields: [bookId], references: [id], onDelete: SetNull)
  place       Place?       @relation(fields: [placeId], references: [id], onDelete: SetNull)
  polls       Poll[]
  attendances Attendance[]

  @@index([label(sort: Desc)])
  @@map("rounds")
}

/// §4.2 책
model Book {
  id         String   @id @default(uuid()) @db.Uuid
  title      String
  author     String
  totalPages Int      @map("total_pages")
  coverKey   String?  @map("cover_key")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  rounds     Round[]
  candidates PollCandidate[]
  ratings    Rating[]
  reviews    Review[]

  @@map("books")
}

/// §4.3 장소
model Place {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  address   String
  memo      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  rounds     Round[]
  candidates PollCandidate[]

  @@map("places")
}

/// §4.4 투표 — 마감자 기록 없음
model Poll {
  id                String     @id @default(uuid()) @db.Uuid
  roundId           String     @map("round_id") @db.Uuid
  kind              PollKind
  status            PollStatus @default(open)
  closedAt          DateTime?  @map("closed_at")
  resultCandidateId String?    @map("result_candidate_id") @db.Uuid
  tieCandidateIds   String[]   @default([]) @map("tie_candidate_ids") @db.Uuid
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  round      Round           @relation(fields: [roundId], references: [id], onDelete: Cascade)
  candidates PollCandidate[]

  @@unique([roundId, kind])
  @@map("polls")
}

/// §4.5 후보
model PollCandidate {
  id        String   @id @default(uuid()) @db.Uuid
  pollId    String   @map("poll_id") @db.Uuid
  bookId    String?  @map("book_id") @db.Uuid
  placeId   String?  @map("place_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  poll   Poll        @relation(fields: [pollId], references: [id], onDelete: Cascade)
  book   Book?       @relation(fields: [bookId], references: [id], onDelete: Cascade)
  place  Place?      @relation(fields: [placeId], references: [id], onDelete: Cascade)
  checks VoteCheck[]

  @@index([pollId])
  @@map("poll_candidates")
}

/// §4.6 체크 — 누가 눌렀는지는 없음, 브라우저당 후보별 1회
model VoteCheck {
  id          String   @id @default(uuid()) @db.Uuid
  candidateId String   @map("candidate_id") @db.Uuid
  clientId    String   @map("client_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  candidate PollCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([candidateId, clientId])
  @@index([candidateId])
  @@map("vote_checks")
}

/// §4.7 참석 응답 — 이름 자유 입력
model Attendance {
  id        String           @id @default(uuid()) @db.Uuid
  roundId   String           @map("round_id") @db.Uuid
  clientId  String           @map("client_id") @db.Uuid
  name      String
  status    AttendanceStatus
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  round Round @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@unique([roundId, clientId])
  @@index([roundId])
  @@map("attendances")
}

/// §4.8 별점
model Rating {
  id        String   @id @default(uuid()) @db.Uuid
  bookId    String   @map("book_id") @db.Uuid
  clientId  String   @map("client_id") @db.Uuid
  name      String
  score     Int      @db.SmallInt
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([bookId, clientId])
  @@index([bookId])
  @@map("ratings")
}

/// §4.9 한줄평 — 댓글 없음
model Review {
  id        String   @id @default(uuid()) @db.Uuid
  bookId    String   @map("book_id") @db.Uuid
  clientId  String   @map("client_id") @db.Uuid
  name      String
  body      String
  spoiler   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([bookId, createdAt(sort: Desc)])
  @@map("reviews")
}

/// 표지 이미지 본문 — 별도 오브젝트 스토리지 설정 없이 동작하도록 DB에 저장 (S3 드라이버 선택 시 미사용)
model CoverFile {
  key         String   @id
  data        Bytes
  contentType String   @map("content_type")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("cover_files")
}
