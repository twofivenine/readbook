# PostgreSQL 연결 문자열 (Supabase / Neon / 로컬)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/readbook?schema=public"

# 표지 이미지 저장소 (S3 호환: Supabase Storage / Cloudflare R2 등)
# 비워두면 로컬 파일 시스템(public/uploads)에 저장합니다 (개발용).
COVER_STORAGE_DRIVER="local"          # local | s3
S3_ENDPOINT=""                        # 예: https://<project>.supabase.co/storage/v1/s3
S3_REGION="auto"
S3_BUCKET="covers"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""                 # 예: https://<project>.supabase.co/storage/v1/object/public/covers

# 개발·테스트에서만: 쓰기 레이트 리밋(60회/분) 해제
# RATE_LIMIT_DISABLED="1"
